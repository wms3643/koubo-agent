# 本文件是配置示例；应用读取进程环境变量，不自动加载 .env。
# 不设置 DATABASE_URL 时使用 SQLite 与本地会话文件。
DATABASE_URL=postgresql://koubo:replace-with-your-password@127.0.0.1:5432/koubo
POSTGRES_PASSWORD=replace-with-your-password
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379
KB_CHECKPOINT_CACHE_TTL=60
# 外部模型与媒体配置
LK_API_KEY=
KB_PROJECTS=
KB_PYTHON=
